# ============================================
# TLDS Events - Environment Configuration
# ============================================

# Server Configuration
PORT=10000
NODE_ENV=production

# Frontend URLs (for CORS)
FRONTEND_URL=https://events.thinklabdigitalsolutions.com
# Optional: Old domain for migration period
# OLD_FRONTEND_URL=https://tldsevents.vercel.app

# Database Configuration
# Get this from MongoDB Atlas or Render managed database
MONGO_URI=your_mongodb_connection_string

# ============================================
# RAZORPAY PAYMENT CONFIGURATION
# ============================================
# Use production keys for live payments
# Use test keys for development (get from Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_SECRET=your_razorpay_secret_here

# Razorpay Webhook Secret (if using webhooks)
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# ADMIN CONFIGURATION
# ============================================
# Change these to secure credentials for production
ADMIN_USERNAME=your_secure_admin_username
ADMIN_PASSWORD=your_secure_admin_password

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate a strong random string (min 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secure_jwt_secret_min_32_chars

# JWT Expiration
JWT_EXPIRES_IN=24h

# ============================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ============================================
# Use an app-specific password if using Gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# ============================================
# OPTIONAL: THIRD-PARTY SERVICES
# ============================================
# Cloudinary for image uploads (optional)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# SECURITY SETTINGS
# ============================================
# Cookie secure flag (set to true for HTTPS)
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
